# Environment variable template. Copy to `.env` and fill in actual values.
# DO NOT commit your real `.env` file.

# ---------------------------------------------------------------------------
# AI Assistant
# ---------------------------------------------------------------------------
# Server-side variables used by the Vite dev server (via node reverse proxy)
# and by the nginx reverse proxy in the production Docker image. They are
# intentionally NOT prefixed with VITE_ so the key never ships in the client
# bundle.
#
# Leave ANTHROPIC_API_KEY unset to disable the AI Assistant gracefully — the
# frontend will surface a clear error message instead of silently failing.
ANTHROPIC_API_KEY=
# Default: claude-haiku-4-5 (fast + cost-efficient). Other valid values you
# may have access to: claude-sonnet-4-5, claude-opus-4-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Access gate (client-side gating only — NOT real auth)
# ---------------------------------------------------------------------------
# When unset, every login attempt is rejected. Set an explicit password for
# internal deploys, and put the app behind SSO / an authenticating reverse
# proxy for anything user-facing.
VITE_APP_PASSWORD=
