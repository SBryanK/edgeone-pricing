# Keep the build context lean so Docker builds stay fast and don't leak
# local secrets / caches into image layers.

# Version control
.git
.gitignore
.gitattributes
.github

# Editor / IDE
.vscode
.idea
.claude
.cursor
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build / caches
dist
build
coverage
.next
.nuxt
.cache
.parcel-cache
.eslintcache
.turbo
.vite
.tmp

# Logs
logs
*.log
dev_server.log
server.log

# Env files — never ship real values into an image
.env
.env.*
.env.local
.env.*.local
!.env.example

# Tests / stories — not needed in runtime image
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
**/__mocks__

# Project docs that shouldn't inflate the build context
# (keep README for reference; strip the others)
DOCKER-SETUP-SOLUTIONS.md
FIX-DOCKER.md
SOLUTION.md
TROUBLESHOOTING.md
test-docker-setup.md

# Local-only helper scripts duplicated by the Dockerfile
start-server.sh
build-docker.sh
reverse-proxy.js
docker-compose.yml